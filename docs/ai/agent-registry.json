{
  "schema": "mdj.agent-registry.v1",
  "note": "R4 / IA rule 2. Declarative catalog only. ELIXIS runtime still reads its tool list from elixis-chat until a later ticket wires this file.",
  "agents": [
    {
      "id": "elixis",
      "name": "ELIXIS",
      "version": "1.0.0",
      "mission": "Staff/office executive assistant: read authoritative data, calculate via approved adapters, draft copy, and append a staff lead note via crear_nota_lead. Does not send messages or move money.",
      "role_required": ["is_staff", "office"],
      "tools": [
        {
          "name": "consultar_finanzas",
          "mode": "read",
          "target": "financial-engine",
          "approval_policy": "none",
          "metrics": [
            "getNetCash",
            "getCashInflow",
            "getCashOutflow",
            "getAccountsReceivable",
            "getAccountsPayable"
          ]
        },
        {
          "name": "crear_nota_lead",
          "mode": "write",
          "target": "agent_lead_notes",
          "approval_policy": "auto_staff",
          "via": "agent_lead_note_create",
          "audit": "agent_action_log_write"
        }
      ],
      "approval_policy": "none",
      "data_scope": {
        "read": [
          "financial-engine metrics",
          "residency_schedule",
          "public_dj_profiles roster",
          "event_builder_orders bookings",
          "leads pipeline"
        ],
        "write": [
          "agent_lead_notes"
        ]
      },
      "memory": "stateless",
      "memory_detail": "conversation-only; context is rebuilt each turn; no agent_memory table",
      "triggers": ["staff authenticated POST to elixis-chat"],
      "write_tools": [
        "crear_nota_lead"
      ]
    }
  ]
}
