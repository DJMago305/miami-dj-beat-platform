{
  "schema": "mdj.agent-registry.v1",
  "note": "R4 / IA rule 2 + R11. Catalog only. Runtime tools still live in elixis-chat; the orchestrator routes intent and forwards to that specialist.",
  "agents": [
    {
      "id": "elixis-orchestrator",
      "name": "ELIXIS Orchestrator",
      "version": "1.0.0",
      "kind": "orchestrator",
      "mission": "Classify staff intent (finance, lead_note, general) and delegate to specialist agents. Does not call tools or mutate records.",
      "role_required": ["is_staff", "office"],
      "tools": [],
      "write_tools": [],
      "delegates_to": ["elixis"],
      "approval_policy": "none",
      "data_scope": {
        "read": [],
        "write": []
      },
      "memory": "stateless",
      "triggers": ["staff authenticated POST to elixis-orchestrator"]
    },
    {
      "id": "elixis",
      "name": "ELIXIS",
      "version": "1.0.0",
      "kind": "specialist",
      "mission": "Staff/office specialist for finance reads (consultar_finanzas) and staff lead notes (crear_nota_lead). Invoked directly or via elixis-orchestrator. Does not send messages or move money.",
      "role_required": ["is_staff", "office"],
      "tools": [
        {
          "name": "consultar_finanzas",
          "mode": "read",
          "target": "financial-engine",
          "approval_policy": "none",
          "metrics": [
            "getNetCash",
            "getCashInflow",
            "getCashOutflow",
            "getAccountsReceivable",
            "getAccountsPayable"
          ]
        },
        {
          "name": "crear_nota_lead",
          "mode": "write",
          "target": "agent_lead_notes",
          "approval_policy": "auto_staff",
          "via": "agent_lead_note_create",
          "audit": "agent_action_log_write"
        }
      ],
      "approval_policy": "none",
      "data_scope": {
        "read": [
          "financial-engine metrics",
          "residency_schedule",
          "public_dj_profiles roster",
          "event_builder_orders bookings",
          "leads pipeline"
        ],
        "write": [
          "agent_lead_notes"
        ]
      },
      "memory": "stateless",
      "memory_detail": "conversation-only; context is rebuilt each turn; no agent_memory table",
      "triggers": ["staff authenticated POST to elixis-chat"],
      "write_tools": [
        "crear_nota_lead"
      ]
    }
  ]
}
