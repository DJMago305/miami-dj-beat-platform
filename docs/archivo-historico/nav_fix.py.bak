import os
import re
import json

web_dir = os.path.join(os.getcwd(), 'web')
files = [f for f in os.listdir(web_dir) if f.endswith('.html') and os.path.isfile(os.path.join(web_dir, f))]

# Order Maestro (Base = Home)
master_desktop_nav = """                    <a href="./index.html" data-i18n="nav-home">Home</a>
                    <a href="./index.html#services" data-i18n="nav-services">Services</a>
                    <a href="./rentals.html" data-i18n="nav-rentals">Event Services</a>
                    <a href="./shop.html" style="color:var(--gold); font-weight:800;">Shop</a>
                    <a href="./dj-tools.html" data-i18n="nav-tools">Tools</a>
                    <div class="nav-item-dropdown">
                        <a href="#" style="cursor: default;">Academia <span class="caret">▾</span></a>
                        <div class="nav-dropdown-menu">
                            <a href="./courses.html">Cursos y Certificación</a>
                            <a href="./dj-knowledge.html">Cultura y Biblioteca DJ</a>
                        </div>
                    </div>
                    <a href="./dj-profile.html?tab=flow" id="nav-flow-link" style="color:var(--gold); display:none; font-weight:800;">Flow</a>
                    <a href="./jobs.html" data-i18n="nav-jobs">Jobs</a>
                    <a href="./index.html#contact" data-i18n="nav-contact">Contact</a>"""

master_mobile_nav = """                        <a href="./index.html" data-i18n="nav-home">Home</a>
                        <a href="./index.html#services" data-i18n="nav-services">Services</a>
                        <a href="./rentals.html" data-i18n="nav-rentals">Event Services</a>
                        <a href="./shop.html" style="color:#c5a059;font-weight:800;">Shop</a>
                        <a href="./dj-tools.html" data-i18n="nav-tools">Tools</a>
                        <a href="./courses.html">🎓 Academia: Cursos</a>
                        <a href="./dj-knowledge.html">📚 Academia: Cultura DJ</a>
                        <a href="./jobs.html" data-i18n="nav-jobs">Jobs</a>
                        <a href="./index.html#contact" data-i18n="nav-contact">Contacto</a>
                        <a href="login.html" id="header-login-btn-mobile" data-i18n="btn-login" style="color:var(--gold); font-weight:800;">Login</a>
                        <a href="./dj-profile.html" id="nav-my-profile-mobile" style="display:none; color:var(--gold); font-weight:900;" data-i18n="menu-account">MY PROFILE</a>"""

audit_report = []
drifting_pages = []

for file in files:
    p = os.path.join(web_dir, file)
    with open(p, 'r', encoding='utf-8') as f:
        html = f.read()

    has_drift = False

    page_desktop_nav = master_desktop_nav
    page_mobile_nav = master_mobile_nav

    if file == 'index.html':
        page_desktop_nav = page_desktop_nav.replace('<a href="./index.html"', '<a href="./index.html" class="active"')
        page_mobile_nav = page_mobile_nav.replace('<a href="./index.html"', '<a href="./index.html" class="active"')
        page_desktop_nav = page_desktop_nav.replace('href="./index.html#', 'href="#')
        page_mobile_nav = page_mobile_nav.replace('href="./index.html#', 'href="#')
    else:
        file_ref = f'./{file}'
        def replace_active(match):
            m = match.group(1)
            if 'class=' in m:
                return m.replace('class="', 'class="active ')
            else:
                return m.replace('>', ' class="active">')
                
        page_desktop_nav = re.sub(f'(<a href="{file_ref}"[^>]*>)', replace_active, page_desktop_nav)
        page_mobile_nav = re.sub(f'(<a href="{file_ref}"[^>]*>)', replace_active, page_mobile_nav)

    desktop_match = re.search(r'<nav class="nav top-nav" id="mainNav">[\s\S]*?</nav>', html)
    if desktop_match:
        content = desktop_match.group(0)
        # Check drift
        shop_idx = content.find('Shop</a>')
        jobs_idx = content.find('Jobs</a>')
        if 'Shop</a>' not in content or (jobs_idx != -1 and shop_idx > jobs_idx) or 'Directory' in content:
            has_drift = True

    mobile_match = re.search(r'<nav class="mobile-nav">[\s\S]*?</nav>', html)
    if mobile_match:
        content = mobile_match.group(0)
        shop_idx = content.find('Shop</a>')
        jobs_idx = content.find('Jobs</a>')
        if 'Shop</a>' not in content or (jobs_idx != -1 and shop_idx > jobs_idx) or 'Directory' in content:
            has_drift = True
            
        # In mobile index.html, Shop was originally below Jobs too! So drift is almost everywhere for Mobile.
        
    if has_drift:
        drifting_pages.append(file)
    audit_report.append(file)

    if desktop_match:
        html = html.replace(desktop_match.group(0), f'<nav class="nav top-nav" id="mainNav">\n{page_desktop_nav}\n                </nav>')
    if mobile_match:
        html = html.replace(mobile_match.group(0), f'<nav class="mobile-nav">\n{page_mobile_nav}\n                    </nav>')

    with open(p, 'w', encoding='utf-8') as f:
        f.write(html)

print(json.dumps({'auditReport': audit_report, 'driftingPages': list(set(drifting_pages))}))
