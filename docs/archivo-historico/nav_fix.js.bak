const fs = require('fs');
const path = require('path');

const webDir = path.join(__dirname, 'web');
const files = fs.readdirSync(webDir)
    .filter(file => file.endsWith('.html') && fs.statSync(path.join(webDir, file)).isFile());

// Order Maestro (Base = Home)
const masterDesktopNav = `                    <a href="./index.html" data-i18n="nav-home">Home</a>
                    <a href="./index.html#services" data-i18n="nav-services">Services</a>
                    <a href="./rentals.html" data-i18n="nav-rentals">Event Services</a>
                    <a href="./shop.html" style="color:var(--gold); font-weight:800;">Shop</a>
                    <a href="./dj-tools.html" data-i18n="nav-tools">Tools</a>
                    <div class="nav-item-dropdown">
                        <a href="#" style="cursor: default;">Academia <span class="caret">▾</span></a>
                        <div class="nav-dropdown-menu">
                            <a href="./courses.html">Cursos y Certificación</a>
                            <a href="./dj-knowledge.html">Cultura y Biblioteca DJ</a>
                        </div>
                    </div>
                    <a href="./dj-profile.html?tab=flow" id="nav-flow-link" style="color:var(--gold); display:none; font-weight:800;">Flow</a>
                    <a href="./jobs.html" data-i18n="nav-jobs">Jobs</a>
                    <a href="./index.html#contact" data-i18n="nav-contact">Contact</a>`;

const masterMobileNav = `                        <a href="./index.html" data-i18n="nav-home">Home</a>
                        <a href="./index.html#services" data-i18n="nav-services">Services</a>
                        <a href="./rentals.html" data-i18n="nav-rentals">Event Services</a>
                        <a href="./shop.html" style="color:#c5a059;font-weight:800;">Shop</a>
                        <a href="./dj-tools.html" data-i18n="nav-tools">Tools</a>
                        <a href="./courses.html">🎓 Academia: Cursos</a>
                        <a href="./dj-knowledge.html">📚 Academia: Cultura DJ</a>
                        <a href="./jobs.html" data-i18n="nav-jobs">Jobs</a>
                        <a href="./index.html#contact" data-i18n="nav-contact">Contacto</a>
                        <a href="login.html" id="header-login-btn-mobile" data-i18n="btn-login" style="color:var(--gold); font-weight:800;">Login</a>
                        <a href="./dj-profile.html" id="nav-my-profile-mobile" style="display:none; color:var(--gold); font-weight:900;" data-i18n="menu-account">MY PROFILE</a>`;

let auditReport = [];
let driftingPages = [];

for (const file of files) {
    const p = path.join(webDir, file);
    let html = fs.readFileSync(p, 'utf8');
    let hasDrift = false;

    // Remove "class='active'" from master links depending on current file
    let pageDesktopNav = masterDesktopNav;
    let pageMobileNav = masterMobileNav;

    // Fix active state
    if (file === 'index.html') {
        pageDesktopNav = pageDesktopNav.replace('<a href="./index.html"', '<a href="./index.html" class="active"');
        pageMobileNav = pageMobileNav.replace('<a href="./index.html"', '<a href="./index.html" class="active"');
        // Fix home anchors
        pageDesktopNav = pageDesktopNav.replace(/href="\.\/index\.html#/g, 'href="#');
        pageMobileNav = pageMobileNav.replace(/href="\.\/index\.html#/g, 'href="#');
    } else {
        const fileRef = `./${file}`;
        const regex = new RegExp(`(<a href="${fileRef}"[^>]*>)`);
        pageDesktopNav = pageDesktopNav.replace(regex, (match) => match.includes('class=') ? match.replace('class="', 'class="active ') : match.replace('>', ' class="active">'));
        pageMobileNav = pageMobileNav.replace(regex, (match) => match.includes('class=') ? match.replace('class="', 'class="active ') : match.replace('>', ' class="active">'));
    }

    // 1. Audit Desktop Nav
    const desktopMatch = html.match(/<nav class="nav top-nav" id="mainNav">[\s\S]*?<\/nav>/);
    if (desktopMatch) {
        if (!desktopMatch[0].includes('Shop</a>') || desktopMatch[0].indexOf('Shop') > desktopMatch[0].indexOf('Jobs')) {
            hasDrift = true;
        }
        if (desktopMatch[0].includes('Directory')) {
            hasDrift = true;
        }
    }

    // 2. Audit Mobile Nav
    const mobileMatch = html.match(/<nav class="mobile-nav">[\s\S]*?<\/nav>/);
    if (mobileMatch) {
        if (!mobileMatch[0].includes('Shop</a>') || mobileMatch[0].indexOf('Shop') > mobileMatch[0].indexOf('Jobs')) {
            hasDrift = true;
        }
        if (mobileMatch[0].includes('Directory')) {
            hasDrift = true;
        }
    }

    if (hasDrift) {
        driftingPages.push(file);
    }
    auditReport.push(file);

    // Apply the fix
    if (desktopMatch) {
       html = html.replace(desktopMatch[0], `<nav class="nav top-nav" id="mainNav">\n${pageDesktopNav}\n                </nav>`);
    }
    if (mobileMatch) {
       html = html.replace(mobileMatch[0], `<nav class="mobile-nav">\n${pageMobileNav}\n                    </nav>`);
    }

    fs.writeFileSync(p, html);
}

console.log(JSON.stringify({ auditReport, driftingPages }));
