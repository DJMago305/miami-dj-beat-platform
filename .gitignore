
# macOS
.DS_Store
**/.DS_Store

# web deps
web/node_modules/

# Cursor local debug
.cursor/debug*.log

# Sync automático de perfiles de DJ (launchd) — crece cada corrida, no es historial de código
tools/dj-profiles/sync.log
tools/dj-profiles/launchd.out.log
tools/dj-profiles/launchd.err.log

# Agent backups (multi‑GB; never push to GitHub)
.agent/backups/

# Old full-site duplicate (huge; keep out of GitHub)
web_backup_20260312/
web_BACKUP_HOY/

# Local legacy / scratch backups (not part of the site)
internal/

# Optional local Vercel output experiments
web/build/
.vercel

# MDJPRO macOS installer (~12MB+); publish via Supabase Storage, not Git
web/installers/*.pkg

# Videos: served from Supabase Storage; do not commit (keeps repo small)
web/assets/**/*.mp4
web/assets/**/*.mov
web/assets/**/*.webm
web/assets/**/*.m4v
web/assets/**/*.mkv

# Material de la sesion de green-screen de DJMago (renombrada 2026-08-29,
# antes decia "Elixis IA" por error -- el contenido real es DJMago, no
# ELIXIS). Mezcla fotos/videos de referencia descartados CON el clip real
# en uso (djmago-idle-boomerang.mp4, referenciado en staff.html y
# mdj-commander.html) -- por eso sigue ignorada como carpeta (los videos
# van a Storage, no a git, regla ya existente arriba), pero el archivo en
# uso real no es solo "material crudo". Los 5 sprites .webp de boca que SI
# se versionan en git viven fuera de esta carpeta, en
# web/assets/elixis-boca-*.webp.
web/assets/DJMago IA/
.aider*
.env*.local

# Respaldo local con secretos dentro: nunca debe viajar en el repositorio.
BACKUP_CAMBIOS_HOY.patch

# sobre temporal con las claves VAPID -- nunca se comitea
.vapid.env

# Proyecto aparte (1.6GB, node_modules + .env) que no pertenece a este repo —
# vivia anidado dentro de esta misma carpeta, movido a
# ~/Developer/Archivos_Viejos/ el 2026-08-25 (auditoria de worktrees).
# Se deja la regla como blindaje por si vuelve a aparecer aqui.
MiamiDJBeat-MigracionV2/

# Worktrees de agentes: deben vivir en .worktrees/ (raiz, fuera de git) o en
# el scratchpad temporal del agente — nunca en el escritorio. Ver
# auditoria de worktrees 2026-08-25 (11 carpetas huerfanas encontradas ahi).
# La regla de abajo (.claude/worktrees/) no cubria la ruta real donde de
# hecho viven (.worktrees/, raiz) -- brecha real encontrada 2026-08-29 al
# ir a comitear (235MB sin ignorar). Corregida.
.worktrees/
.claude/worktrees/
.claude/*.bak
.claude/settings.local.json

# Cualquier variante de archivo de entorno con secretos, sin importar el
# sufijo — .env*.local (arriba) no cubria .env ni .env.production sueltos.
*.env
*.env.*

# Fixtures de prueba de Serato para SmartCrate IA (.crate, "database V2"):
