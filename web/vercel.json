{
  "rewrites": [
    { "source": "/venues/:venueSlug/:roomSlug", "destination": "/venue-room.html" },
    { "source": "/:page([^.]+)", "destination": "/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
