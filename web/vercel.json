{
  "redirects": [
    { "source": "/services", "destination": "/rentals.html", "permanent": true },
    { "source": "/services.html", "destination": "/rentals.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/venues/:venueSlug/:roomSlug", "destination": "/venue-room.html" },
    { "source": "/t/:id", "destination": "/t.html?id=:id" },
    { "source": "/:page([^.]+)", "destination": "/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
